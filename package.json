{
  "name": "sameerkhan-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx tsx scripts/generate-markdown-files.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:agents": "tsx --test scripts/agent-readiness.test.mjs",
    "generate-md": "npx tsx scripts/generate-markdown-files.ts",
    "validate:content": "remark-lint-frontmatter-validation \"content/blog/**/*.mdx\" --schema schemas/post.schema.json && markdownlint-cli2 && eslint content/blog",
    "fix-content": "markdownlint-cli2 --fix; npm run validate:content",
    "test:agents:ci": "start-server-and-test start http://localhost:3000 test:agents"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "negotiator": "^1.1.0",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/config": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-mdx": "^3.8.1",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.26",
    "remark-lint-frontmatter-validation": "^1.0.4",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unpdf": "^1.8.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
