# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal research (not for public)
/research/

# playwright-mcp debug artifacts
/.playwright-mcp/

# gh-aw downloaded run artifacts (gh aw audit / gh aw logs)
/.github/aw/logs/

# build artifacts (regenerated by prebuild)
/public/blog/*.md
/public/index.md

# Claude Code: personal settings + installed third-party skills (restore via skills-lock.json)
.claude/
