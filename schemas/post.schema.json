{
  "title": "samkhan.net blog post frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "date", "author", "tags", "category", "published"],
  "properties": {
    "title": { "type": "string", "minLength": 10, "maxLength": 120 },
    "description": { "type": "string", "minLength": 40, "maxLength": 320 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Quoted YYYY-MM-DD string (an unquoted YAML date parses as a Date object and breaks the site loader)"
    },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "author": { "type": "string", "const": "Sameer Khan" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 40 }
    },
    "category": { "type": "string", "minLength": 2, "maxLength": 40 },
    "published": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "image": { "type": "string", "pattern": "^/" },
    "imageAlt": { "type": "string", "minLength": 5 }
  }
}
