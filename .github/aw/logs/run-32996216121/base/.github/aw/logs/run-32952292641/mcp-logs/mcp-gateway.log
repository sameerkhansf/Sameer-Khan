ack Compose components, data models, or standard helper functions.\",\"matches\":[{\"text\":\"AI\",\"indices\":[13,15]},{\"text\":\"AI\",\"indices\":[42,44]},{\"text\":\"coding\",\"indices\":[45,51]},{\"text\":\"assistant\",\"indices\":[52,61]},{\"text\":\"AI\",\"indices\":[234,236]}]}]}]}"}],"resultType":"complete"}}
